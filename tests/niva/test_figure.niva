#
# `figure` verb tests — quick map-image rendering (pure Python via MockBackend).

# ── TestFigureDefaults ──────────────────────────────────────────

# test_bare_command_records_sensible_defaults
load dem.tif | figure out.png

# test_pass_through_chains
load roads.gpkg | figure preview.png | save out.gpkg

# ── TestFigureOptions ───────────────────────────────────────────

# test_all_options_parsed
load a.gpkg | figure m.png size=1600x900 dpi=150 extent=10,20,30,40 layers="b.gpkg;c.tif" basemap=osm bg=white labels=name

# test_extent_layer_keyword_is_none
load a.gpkg | figure m.png extent=layer

# test_extent_path_kept_as_string
load a.gpkg | figure m.png extent=aoi.gpkg

# test_size_accepts_unicode_times
load a.gpkg | figure m.png size=800×600

# ── TestFigureErrors ────────────────────────────────────────────

# test_needs_a_layer
#   (pure Python — no niva flow)

# test_needs_output_path
load a.gpkg | figure

# test_rejects_non_image_extension
load a.gpkg | figure out.pdf

# test_rejects_bad_size
load a.gpkg | figure out.png size=big

# test_rejects_extra_positional
load a.gpkg | figure a.png b.png

# test_rejects_unknown_option
load a.gpkg | figure out.png rotation=45
