#
# Tests for directory iteration (`each`) and multi-layer write (`save … as`).

# ── TestMultiLayerWrite ─────────────────────────────────────────

# test_save_as_names_the_layer_and_appends
load a.gpkg | dissolve | save out.gpkg as regions

# test_plain_save_overwrites_file
load a.gpkg | save out.gpkg

# test_save_as_requires_a_container
load a.gpkg | save out.shp as roads

# ── TestEachBatch ───────────────────────────────────────────────

# test_each_glob_runs_per_file_into_one_gpkg
each "{root}/*.geojson" | reproject EPSG:6346 | save out.gpkg

# test_each_directory_recurses_and_ignores_non_geo
each "{root}" | save out.gpkg

# test_each_expands_multilayer_gpkg
each "{gpkg}" | reproject EPSG:6346 | save collected.gpkg

# test_each_raster_name_template
each "{root}/*.tif" | warp EPSG:6346 | save "{out}/{name}.tif"

# test_batch_save_to_non_container_without_template_errors
each "{root}/*.shp" | save out.shp

# test_each_no_match_errors
each "{root}/*.shp" | save out.gpkg

# test_batch_compacts_gpkg_targets_once
each "{root}/*.geojson" | save out.gpkg

# test_each_must_be_first_stage
load a.gpkg | each "x/*.shp"

# test_name_placeholder_outside_batch_errors
load a.gpkg | save "out/{name}.gpkg"

# ── TestSplit ───────────────────────────────────────────────────

# test_split_dispatches_to_filterbygeometry
load a.gpkg | split polygon | save polys.gpkg

# test_split_accepts_singular_and_plural
load a.gpkg | split {kind} | save out.gpkg

# test_split_rejects_unknown_type
load a.gpkg | split blobs | save out.gpkg

# test_split_needs_a_type
load a.gpkg | split | save out.gpkg
