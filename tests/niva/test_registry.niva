# ── TestBinder ──────────────────────────────────────────────────

# test_buffer_full
buffer 100m dissolve cap=flat segments=12

# test_buffer_defaults_only
buffer 100

# test_distance_units
buffer 2.5km
buffer -10ft

# test_clip_positional_layer
clip city.gpkg

# test_layer_params_are_flagged
clip city.gpkg
spatialjoin with=zones.gpkg

# test_crs_params_are_flagged
reproject EPSG:6346
warp EPSG:3857

# test_layer_arg_expands_tilde
clip /abs/city.gpkg
clip "~/aoi.gpkg"
clipraster ~/dem/mask.gpkg

# test_reproject_crs_and_flag_defaults
reproject EPSG:2262

# test_reproject_flags_settable
reproject EPSG:2262 convert_curved transform_z

# test_dissolve_optional_positional_omitted
dissolve
dissolve landuse

# test_join_options_and_listvalue
join with=census.csv field=tract field2=GEOID fields=pop,income prefix=cen_ discard

# test_join_unmatched_sink
join with=c.csv field=a field2=b unmatched=leftovers.gpkg

# test_zonalstats_enumlist
zonalstats raster=dem.tif band=2 stats=mean,min,max prefix=elev_

# test_zonalstats_enumlist_default
zonalstats raster=dem.tif

# test_missing_required_positional
buffer

# test_too_many_positionals
clip a.gpkg b.gpkg

# test_unknown_option
buffer 100m colour=red

# test_bad_enum_word
buffer 100m cap=triangle

# test_missing_required_option
join field=tract field2=GEOID

# test_bad_number
buffer 100m segments=many

# test_bad_distance
buffer wide

# test_unknown_unit
buffer 100furlongs

# test_error_names_the_stage_line
load x.gpkg | save y.gpkg
buffer 100m cap=triangle
