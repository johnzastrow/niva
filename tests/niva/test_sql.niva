# ── TestDbSave ──────────────────────────────────────────────────

# test_save_table_default_mode
load roads.gpkg | save @pg.roads

# test_save_schema_qualified
load roads.gpkg | save @pg.public.roads

# test_mode_replace_and_append
load roads.gpkg | save @pg.roads mode={mode}

# test_bad_mode_is_error
load roads.gpkg | save @pg.roads mode=upsert

# test_unknown_option_rejected
load roads.gpkg | save @pg.roads overwrite=true

# test_bare_connection_non_batch_is_error
load roads.gpkg | save @pg

# test_as_layer_rejected_on_db_target
load roads.gpkg | save @pg.roads as roads2

# test_name_template_rejected_on_db_target
load roads.gpkg | save "@pg.{name}"

# test_file_save_still_rejects_options
load roads.gpkg | save out.gpkg mode=replace

