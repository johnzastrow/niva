# ── TestRunEscapeHatch ──────────────────────────────────────────

# test_run_passes_algorithm_and_scalar_coerced_params
load dem.tif | run native:slope Z_FACTOR=2 | save slope.tif

# test_run_coerces_float_bool_keeps_strings
load a | run x:y RES=1.5 FLAG=true CRS=EPSG:2262 PATH=a/b.tif

# test_run_standalone_then_pipe
run native:something INPUT=a.gpkg | buffer 5m | save o.gpkg

# test_run_requires_algorithm
load a | run

# test_run_rejects_extra_positional
load a | run native:slope native:aspect

# test_run_semicolon_value_becomes_list
run gdal:merge INPUT="a.tif;b.tif;c.tif" DATA_TYPE=5 | save x.tif

# test_run_glob_expands_to_sorted_files
run gdal:buildvirtualraster INPUT="{d}/*.jp2" OUTPUT=/tmp/x.vrt

# test_run_glob_no_match_is_error
run x:y INPUT="/no/such/dir/*.jp2"

# test_run_does_not_glob_an_expression
load a | run native:fieldcalculator FORMULA="area * 2"

# test_run_does_not_glob_a_compact_expression
run gdal:rastercalculator FORMULA="{formula}" INPUT_A=dem.tif OUTPUT=o.tif

# test_load_expands_home
load ~/foo.gpkg | save out.gpkg

# test_explode_alias
load roads.gpkg | explode | save e.gpkg

# ── TestMetadata ────────────────────────────────────────────────

