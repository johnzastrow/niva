load a.gpkg | metadata set title="Cats" keywords=a,b abstract="x" | save o.gpkg

# test_metadata_needs_a_layer
metadata set title="x"

# test_metadata_requires_set_subcommand
load a | metadata get

# test_metadata_requires_fields
load a | metadata set

# test_metadata_rejects_unknown_field
load a | metadata set colour=red

