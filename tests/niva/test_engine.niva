# ── TestSaveCreatesParentDir ────────────────────────────────────

# test_save_makes_nested_parent
load roads.gpkg | buffer 100m | save "{dest}"

# ── TestRunCreatesOutputParentDir ───────────────────────────────

# test_run_output_makes_nested_parent
run grass:r.watershed elevation=dem.tif accumulation={out}

# ── TestPipeline ────────────────────────────────────────────────

# test_load_op_save_threads_the_layer
load roads.gpkg | buffer 100m | save out.gpkg

# test_intermediate_result_is_memory
load a.gpkg | buffer 5m

# test_filter_routes_as_alias
load a.gpkg | filter "pop > 100" | save b.gpkg

# test_multi_flow_returns_last
load a.gpkg | save b.gpkg

load c.gpkg | save d.gpkg

# ── TestDistanceResolution ──────────────────────────────────────

