load a | buffer 100m

# test_feet_on_metre_crs
load a | buffer 100ft

# test_kilometres
load a | buffer 2km

# test_bare_number_is_crs_units
load a | buffer 50

# test_degrees_on_geographic
load a | buffer 0.5deg

# test_linear_on_geographic_is_error
load a | buffer 100m

