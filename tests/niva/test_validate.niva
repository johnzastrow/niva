# Flows lifted from f-strings keep their {python} placeholders — illustrative,
# not directly runnable.
# ============================================================================
#
# Expansive tests for `validate` — the offline niva linter.

# ── TestAcceptsValidFlows ───────────────────────────────────────

# test_valid_flows_have_no_errors
#   (pure Python — no niva flow)

# test_clean_flows_have_no_warnings_either
load a.gpkg | buffer 100m | save b.gpkg
load dem.tif | slope | save s.tif

# test_harness_ids_never_warn_on_params
load t.las | run pdalcli:to_raster attribute=Z filter="x==2" output=g.laz

# ── TestCatchesErrors ───────────────────────────────────────────

# test_invented_verb
load a.gpkg | compute x=1 | save b.gpkg

# test_verb_typo_suggests
load a.gpkg | reproj EPSG:3857 | save b.gpkg

# test_missing_required_arg
load a.gpkg | buffer | save b.gpkg

# test_unknown_alias_option
load a.gpkg | buffer 100m segmentz=5 | save b.gpkg

# test_bad_enum_value
load a.gpkg | buffer 100m cap=triangle | save b.gpkg

# test_transform_before_load
buffer 100m | save b.gpkg

# test_unknown_crs_fails_closed
load a.gpkg | reproject EPSG:999999 | save b.gpkg

# test_name_placeholder_outside_batch
load a.gpkg | save "out/{name}.gpkg"

# test_run_without_id
load a.gpkg | run | save b.gpkg

# test_backslash_is_not_a_continuation
load a.gpkg | buffer 100m \ dissolve | save b.gpkg

# test_grammar_unterminated_quote
load "a.gpkg | buffer 100m

# ── TestLintWarnings ────────────────────────────────────────────

# test_distance_without_unit
load a.gpkg | buffer 100 | save b.gpkg

# test_run_unknown_param_suggests
load a.gpkg | run native:buffer DISTANZE=5 | save b.gpkg

# test_run_unknown_id
load a.gpkg | run native:notreal FOO=1 | save b.gpkg

# test_run_when_alias_exists
load a.gpkg | run native:buffer DISTANCE=5 | save b.gpkg

# test_saga_otb_provider_preference
load i.tif | run otb:Smoothing type=mean | save o.tif

# test_flow_with_no_save
load a.gpkg | buffer 100m

# test_distance_with_unit_is_clean
load a.gpkg | buffer 100m | save b.gpkg

# ── TestSubtleAndLarge ──────────────────────────────────────────

# test_stats_is_not_a_verb
load a.gpkg | stats | save b.gpkg

# test_all_errors_collected_not_just_first
load a.gpkg | compute x=1 | frobnicate | buffer 100m capp=flat | save b.gpkg

# test_large_broken_flow_is_rejected
load a.gpkg | reproj EPSG:3857 | save b.gpkg
buffer 100 | compute q=1 | save c.gpkg
load d.gpkg | zonalstats stats=mean | save e.gpkg

# test_plausible_but_wrong_enum
load a.gpkg | buffer 100m cap=square | save b.gpkg
load a.gpkg | buffer 100m cap=squared | save b.gpkg

# ── TestExerciseCatchesRuntime ──────────────────────────────────

# test_static_only_misses_cross_stage
buffer 100m | save b.gpkg

# test_data_dependent_is_warning_not_error
each "tiles/*.tif" | warp EPSG:3857 | save "out/{name}.tif"

# ── TestValidateCLI ─────────────────────────────────────────────

# test_good_file_exits_zero
load a.gpkg | buffer 100m | save b.gpkg

# test_bad_file_exits_nonzero
load a.gpkg | compute x=1 | save b.gpkg

# test_missing_file_reported
#   (pure Python — no niva flow)

# test_no_args_usage
#   (pure Python — no niva flow)

# ── TestExerciseHasNoSideEffects ────────────────────────────────

# test_assess_report_is_not_written
load a.gpkg | assess to "{report}" | save b.gpkg

# test_catalog_output_is_not_written
#   (pure Python — no niva flow)

# test_remove_does_not_delete
#   (pure Python — no niva flow)

# test_notify_is_not_sent
load a.gpkg | notify "done {ops}" to=topic | save b.gpkg

# test_email_is_not_sent
load a.gpkg | email to=x@example.com subject=hi | save b.gpkg
