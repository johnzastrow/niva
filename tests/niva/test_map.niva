#
# `map` verb tests — composed cartographic layout (pure Python via MockBackend).

# ── TestMapDefaults ─────────────────────────────────────────────

# test_bare_map_turns_decorations_on
load a.gpkg | map out.pdf

# test_bare_flag_strips_all_decorations
load a.gpkg | map out.pdf bare

# test_individual_opt_out
load a.gpkg | map out.pdf nolegend nonortharrow

# test_pass_through_chains
load a.gpkg | map out.pdf | save b.gpkg

# ── TestMapOptions ──────────────────────────────────────────────

# test_full_option_set
load a.gpkg | map plate.pdf title="Terrain" layers="dtm.tif;roads.gpkg" basemap=osm labels=name page=A3 portrait dpi=200 extent=aoi.gpkg

# test_from_project_mode
load a.gpkg | map out.pdf from=study.qgz layout="Overview"

# ── TestMapErrors ───────────────────────────────────────────────

# test_needs_a_layer
#   (pure Python — no niva flow)

# test_needs_output
load a.gpkg | map

# test_rejects_bad_extension
load a.gpkg | map out.gpkg

# test_rejects_unknown_flag
load a.gpkg | map out.pdf frobnicate

# test_rejects_unknown_option
load a.gpkg | map out.pdf rotation=45
