# ── TestRemoveGate ──────────────────────────────────────────────

# test_deletes_primary_and_sidecar_family
remove "{os.path.join(self.tmp, 'roads.shp')}"

# test_dryrun_deletes_nothing
remove "{gpkg}" -dryrun

# test_force_deletes_non_allowlisted_exact_path_only
remove "{py}" force

# test_refuse_non_allowlisted_without_force
remove "{md}"

# test_refuse_conn_ref
remove @pg.public.roads

# test_refuse_glob
remove "{self.tmp}/*.gpkg"

# test_refuse_directory
remove "{self.tmp}"

# test_missing_path_is_idempotent
remove "{os.path.join(self.tmp, 'never.gpkg')}"

# test_no_options_allowed
remove "{self._touch('a.gpkg')}" mode=force

# test_batch_each_remove_dedupes_and_clears
each "{self.tmp}/*.gpkg" | remove
