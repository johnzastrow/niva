# test_examples_use_the_first_real_source
niva 'load "x.gpkg|layername=roads" | reproject EPSG:3857 | buffer 100m | save ~/buffered.gpkg'
| fixgeom | save ~/fixed.gpkg
| centroid

# test_examples_include_write_into_existing_targets
| save ~/analysis.gpkg as roads
| save @conn.public.roads mode=append

# test_write_example_sanitises_a_problematic_name
| save ~/analysis.gpkg as my_roads_1
| save @conn.public.my_roads_1 mode=append

