# Tests for the utility verbs: notify (ntfy), email, catalog. No QGIS, no network —

# ── TestNotify ──────────────────────────────────────────────────

# test_send_ntfy_posts_to_resolved_url
notify "all done" to=mytopic title=niva

# test_notify_requires_message
notify to=x

# test_send_ntfy_requires_topic
#   (pure Python — no niva flow)

# test_notify_is_pass_through
load a.gpkg | notify "x" to=t | save out.gpkg

