# ── TestCatalog ─────────────────────────────────────────────────

# test_catalog_recurses_and_writes_report
catalog "{root}"

# test_catalog_requires_a_directory
catalog /no/such/dir/here

# test_catalog_custom_output_path
catalog "{root}" to="{out}"

# test_catalog_deep_reports_quality_and_reaches_profiler
