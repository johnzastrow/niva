# ============================================================================
# Companion to tests/test_stress.py — what each test exercises, in niva form.
# AUTO-GENERATED by scripts/gen_test_niva.py — do not edit by hand.
# Regenerate:  python scripts/gen_test_niva.py   (CI fails if this is stale)
# Flows lifted from f-strings keep their {python} placeholders — illustrative,
# not directly runnable.
# ============================================================================
#
# Long-running RESILIENCE / soak tests — one per component.

# ── TestFigureResilience ────────────────────────────────────────

# test_large_vector_figure
load "{self.big_vector}" | figure "{out}" size=2000x2000 labels=name

# test_large_raster_figure
load "{self.big_raster}" | figure "{out}" size=2000x2000

# ── TestMapResilience ───────────────────────────────────────────

# test_large_vector_map
load "{self.big_vector}" | map "{out}" title="Stress" page=A3 dpi=200

# test_many_layer_map
load "{self.big_vector}" | map "{out}" layers="{self.big_raster}" labels=name page=A3 dpi=200

# ── TestPipelineResilience ──────────────────────────────────────

# test_long_chained_pipeline
load "{self.big_vector}" | reproject EPSG:4326 | reproject EPSG:3857 | buffer 50m | fixgeom | dissolve | explode | fixgeom | save "{out}"

# ── TestPointCloudResilience ────────────────────────────────────

# test_pdalcli_dtm_and_map
load "{_TILES[0]}" | run pdalcli:to_raster attribute=Z filter="Classification==2" resolution=1 | save "{dtm}"
load "{dtm}" | map "{os.path.join(tmp, 'dtm.pdf')}" title="DTM"
