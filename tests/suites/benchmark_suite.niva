# =============================================================================
# niva BENCHMARK SUITE — pressure test: CPU · memory · disk · network
# =============================================================================
# Suites 1–3 prove niva is CORRECT. This suite measures how it PERFORMS, and records the numbers
# so runs can be compared later (across niva versions, hardware, or after a refactor). It is run
# by the instrumented harness run_benchmark_suite.py, which captures per test: wall time, CPU
# time, peak & delta resident memory, disk-write bytes, output size, and feature count — plus an
# environment fingerprint — to ~/niva-test-results (JSON + Markdown, timestamped, host-tagged).
#
# DATA: runs entirely on SYNTHETIC data generated by `tests/datagen/make_bigdata.py` (offline,
# deterministic, GDAL-only) so any clone can benchmark at full weight with no machine-local data:
#       python3 tests/datagen/make_bigdata.py            # writes data/bench.gpkg + data/bench_dem.tif
#   bench.gpkg layers (EPSG:6346, metres): polys_small (1k) · polys_med (10k) · polys_big (60k)
#   · points_big (60k) · lines_med (5k);  bench_dem.tif = 2000² Float32 (use --scale to go bigger).
# For an even HARDER run on real-world data, see tests/datagen/bigdata_urls.md (wget/curl public sets).
#
# The header's CATEGORY names the dimension under stress: `cpu`, `memory`, `disk`, `network`.
# Tests come in SIZE TIERS (1k / 10k / 60k features) so the metrics trace a scaling curve.
#
# Run with:
#   PYTHONPATH=<repo>:/usr/share/qgis/python:/usr/lib/python3/dist-packages \
#     QT_QPA_PLATFORM=offscreen python3 tests/suites/run_benchmark_suite.py tests/suites/benchmark_suite.niva
#
# Directive syntax (ordinary niva comments, so it's also `niva run`-able):
#   # ===== TEST NN | <cpu|memory|disk|network> | description =====
#   <flow line(s)>
#   #@out <path|@conn.table> :: <vector|raster|table|file> [>=N]   what to size/count
#   #@cleanup remove <path> [force]                               tidy up the output
# =============================================================================


# ===== PREAMBLE | env | confirm the generated benchmark data exists =====
catalog "{data}" to=/tmp/niva_benchmark/00_catalog.md
#@out /tmp/niva_benchmark/00_catalog.md :: file
#@cleanup remove /tmp/niva_benchmark/00_catalog.md force


# ------------------------------------------------------------------ CPU (geometry throughput)
# ===== TEST 01 | cpu | buffer — 1k polygons (small tier) =====
load "{data}/bench.gpkg|layername=polys_small" | buffer 10m | save /tmp/niva_benchmark/b01.gpkg
#@out /tmp/niva_benchmark/b01.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b01.gpkg

# ===== TEST 02 | cpu | buffer — 10k polygons (medium tier) =====
load "{data}/bench.gpkg|layername=polys_med" | buffer 10m | save /tmp/niva_benchmark/b02.gpkg
#@out /tmp/niva_benchmark/b02.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b02.gpkg

# ===== TEST 03 | cpu | buffer — 60k polygons (large tier) =====
load "{data}/bench.gpkg|layername=polys_big" | buffer 5m | save /tmp/niva_benchmark/b03.gpkg
#@out /tmp/niva_benchmark/b03.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b03.gpkg

# ===== TEST 04 | cpu | reproject — 10k polygons → EPSG:4326 (medium) =====
load "{data}/bench.gpkg|layername=polys_med" | reproject EPSG:4326 | save /tmp/niva_benchmark/b04.gpkg
#@out /tmp/niva_benchmark/b04.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b04.gpkg

# ===== TEST 05 | cpu | reproject — 60k polygons → EPSG:4326 (large) =====
load "{data}/bench.gpkg|layername=polys_big" | reproject EPSG:4326 | save /tmp/niva_benchmark/b05.gpkg
#@out /tmp/niva_benchmark/b05.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b05.gpkg

# ===== TEST 06 | cpu | simplify — 5k lines =====
load "{data}/bench.gpkg|layername=lines_med" | simplify 10 | save /tmp/niva_benchmark/b06.gpkg
#@out /tmp/niva_benchmark/b06.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b06.gpkg

# ===== TEST 07 | cpu | delaunay — 10k points =====
load "{data}/bench.gpkg|layername=points_big" | sample 10000 | delaunay | save /tmp/niva_benchmark/b07.gpkg
#@out /tmp/niva_benchmark/b07.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b07.gpkg

# ===== TEST 08 | cpu | voronoi — 10k points =====
load "{data}/bench.gpkg|layername=points_big" | sample 10000 | voronoi | save /tmp/niva_benchmark/b08.gpkg
#@out /tmp/niva_benchmark/b08.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b08.gpkg

# ===== TEST 09 | cpu | dissolve — 10k polygons into one =====
load "{data}/bench.gpkg|layername=polys_med" | dissolve | save /tmp/niva_benchmark/b09.gpkg
#@out /tmp/niva_benchmark/b09.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b09.gpkg

# ===== TEST 10 | cpu | intersect — 10k polygons × the big extent =====
load "{data}/bench.gpkg|layername=polys_med" | intersect "{data}/bench.gpkg|layername=polys_big" | save /tmp/niva_benchmark/b10.gpkg
#@out /tmp/niva_benchmark/b10.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b10.gpkg

# ===== TEST 11 | cpu | subdivide — 10k polygons =====
load "{data}/bench.gpkg|layername=polys_med" | fixgeom | subdivide max_nodes=64 | save /tmp/niva_benchmark/b11.gpkg
#@out /tmp/niva_benchmark/b11.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b11.gpkg


# --------------------------------------------------------------- MEMORY (large in-memory sets)
# ===== TEST 12 | memory | load 60k points + reproject =====
load "{data}/bench.gpkg|layername=points_big" | reproject EPSG:3857 | save /tmp/niva_benchmark/b12.gpkg
#@out /tmp/niva_benchmark/b12.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b12.gpkg

# ===== TEST 13 | memory | collect 10k polygons into a single multipart =====
load "{data}/bench.gpkg|layername=polys_med" | collect | save /tmp/niva_benchmark/b13.gpkg
#@out /tmp/niva_benchmark/b13.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b13.gpkg

# ===== TEST 14 | memory | load 60k polygons + centroid =====
load "{data}/bench.gpkg|layername=polys_big" | centroid | save /tmp/niva_benchmark/b14.gpkg
#@out /tmp/niva_benchmark/b14.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b14.gpkg


# ----------------------------------------------------------------- DISK (write / raster I/O)
# ===== TEST 15 | disk | write 1k polygons → GeoPackage (small) =====
load "{data}/bench.gpkg|layername=polys_small" | save /tmp/niva_benchmark/b15.gpkg
#@out /tmp/niva_benchmark/b15.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b15.gpkg

# ===== TEST 16 | disk | write 60k polygons → GeoPackage (large) =====
load "{data}/bench.gpkg|layername=polys_big" | save /tmp/niva_benchmark/b16.gpkg
#@out /tmp/niva_benchmark/b16.gpkg :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b16.gpkg

# ===== TEST 17 | disk | write 60k points → Shapefile =====
load "{data}/bench.gpkg|layername=points_big" | save /tmp/niva_benchmark/b17.shp
#@out /tmp/niva_benchmark/b17.shp :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b17.shp

# ===== TEST 18 | disk | write 60k polygons → GeoJSON (verbose text format) =====
load "{data}/bench.gpkg|layername=polys_big" | reproject EPSG:4326 | save /tmp/niva_benchmark/b18.geojson
#@out /tmp/niva_benchmark/b18.geojson :: vector >=1
#@cleanup remove /tmp/niva_benchmark/b18.geojson

# ===== TEST 19 | disk | raster copy — bench_dem.tif (2000²) =====
load "{data}/bench_dem.tif" | save /tmp/niva_benchmark/b19.tif
#@out /tmp/niva_benchmark/b19.tif :: raster
#@cleanup remove /tmp/niva_benchmark/b19.tif

# ===== TEST 20 | disk | warp bench_dem.tif (2000²) → EPSG:3857 =====
load "{data}/bench_dem.tif" | warp EPSG:3857 | save /tmp/niva_benchmark/b20.tif
#@out /tmp/niva_benchmark/b20.tif :: raster
#@cleanup remove /tmp/niva_benchmark/b20.tif

# ===== TEST 21 | disk | slope on bench_dem.tif (2000²) — raster compute + write =====
load "{data}/bench_dem.tif" | slope | save /tmp/niva_benchmark/b21.tif
#@out /tmp/niva_benchmark/b21.tif :: raster
#@cleanup remove /tmp/niva_benchmark/b21.tif


# --------------------------------------------------------------------- NETWORK (remote latency)
# ===== TEST 22 | network | show remote WFS — cold request =====
show "https://demo.mapserver.org/cgi-bin/wfs?service=WFS" to=/tmp/niva_benchmark/b22.md
#@out /tmp/niva_benchmark/b22.md :: file
#@cleanup remove /tmp/niva_benchmark/b22.md force

# ===== TEST 23 | network | show remote WFS — warm request (same endpoint) =====
show "https://demo.mapserver.org/cgi-bin/wfs?service=WFS" to=/tmp/niva_benchmark/b23.md
#@out /tmp/niva_benchmark/b23.md :: file
#@cleanup remove /tmp/niva_benchmark/b23.md force

# ===== TEST 24 | network | show a second remote WFS (different host) =====
show "https://ahocevar.com/geoserver/wfs?service=WFS" to=/tmp/niva_benchmark/b24.md
#@out /tmp/niva_benchmark/b24.md :: file
#@cleanup remove /tmp/niva_benchmark/b24.md force
