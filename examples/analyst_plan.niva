# =============================================================================
# Analyst plan — Northern Western New York compilation (see analyst_plan.md)
# =============================================================================
# Target CRS: EPSG:6346  (NAD83(2011) / UTM zone 17N)
# Output dir: /home/jcz/Github/niva/data
#
# Pure niva. Tasks 1–4 run as written; Task 5 (QGIS project files) needs a verb
# niva does not have yet — flagged "!! ALERT" with the planned path.
#
# Key verbs used:
#   each "<dir|glob|file.gpkg>"  — iterate files/layers; the rest of the flow runs
#                                  once per item (a failing item is skipped).
#   save <out.gpkg>              — inside a batch, writes each item as its own layer
#                                  into ONE GeoPackage (append, not overwrite).
#   save "<dir>/{name}.tif"      — per-item output path for rasters.
# =============================================================================


# --- Task 1: create /home/jcz/Github/niva/data -------------------------------
# No `mkdir` verb is needed: every save/catalog/assess below auto-creates /data
# on first write.


# --- Task 2: catalog the data sources into /data -----------------------------
catalog "/home/jcz/Downloads/NiagaraBasemap" to="/home/jcz/Github/niva/data/catalog_NiagaraBasemap.md"
catalog "/home/jcz/Downloads/NiagaraOverture" to="/home/jcz/Github/niva/data/catalog_NiagaraOverture.md"
catalog "/home/jcz/Github/marimo_qgis/example" to="/home/jcz/Github/niva/data/catalog_example.md"
load "~/Downloads/ytown_dem_deflate.tif" | assess to "/home/jcz/Github/niva/data/catalog_dem.md"
load "/home/jcz/Downloads/twn_Porter_sp24/porter_ortho.jp2" | assess to "/home/jcz/Github/niva/data/catalog_orthophoto.md"


# --- Task 3: reproject / warp everything to EPSG:6346 into /data -------------

# Directories / multi-layer GeoPackages -> one multi-layer GeoPackage each.
# `each` iterates every vector layer found; `save` collects them into one .gpkg.
# (Any raster encountered by `reproject` is skipped — see the raster lines below.)
each "/home/jcz/Downloads/NiagaraBasemap"  | reproject EPSG:6346 | save "/home/jcz/Github/niva/data/basemap.gpkg"
each "/home/jcz/Downloads/NiagaraOverture" | reproject EPSG:6346 | save "/home/jcz/Github/niva/data/overture.gpkg"
each "/home/jcz/Github/marimo_qgis/example/example.gpkg" | reproject EPSG:6346 | save "/home/jcz/Github/niva/data/collected.gpkg"

# Single rasters -> reprojected copies (GeoTIFF output is lossless-compressed).
load "~/Downloads/ytown_dem_deflate.tif" | warp EPSG:6346 | save "/home/jcz/Github/niva/data/dem.tif"

# Orthophoto -> orthophoto.jp2.
# !! ALERT — niva defaults compression for GeoTIFF only; a `.jp2` save uses the JP2
# driver's defaults (can be large). The warp is fine; for a controlled JP2 use:
#   run gdal:warpreproject INPUT="…/porter_ortho.jp2" TARGET_CRS=EPSG:6346 OUTPUT=/tmp/ortho6346.tif CREATION_OPTIONS="COMPRESS=DEFLATE|TILED=YES"
#   run gdal:translate INPUT=/tmp/ortho6346.tif OUTPUT="/home/jcz/Github/niva/data/orthophoto.jp2" CREATION_OPTIONS="QUALITY=25"
load "/home/jcz/Downloads/twn_Porter_sp24/porter_ortho.jp2" | warp EPSG:6346 | save "/home/jcz/Github/niva/data/orthophoto.jp2"


# --- Task 4: clip everything in /data to the study-area bbox (AOISM) ---------

# Build the study-area bounding box once (dissolve AOISM to one feature -> its bbox):
load "/home/jcz/Github/marimo_qgis/example/example.gpkg|layername=AOISM" | dissolve | boundingbox | save "/home/jcz/Github/niva/data/study_area_bbox.gpkg"

# Clip every layer of each reprojected GeoPackage to that bbox (batch + per-layer):
each "/home/jcz/Github/niva/data/basemap.gpkg"   | clip "/home/jcz/Github/niva/data/study_area_bbox.gpkg" | save "/home/jcz/Github/niva/data/basemap_clip.gpkg"
each "/home/jcz/Github/niva/data/overture.gpkg"  | clip "/home/jcz/Github/niva/data/study_area_bbox.gpkg" | save "/home/jcz/Github/niva/data/overture_clip.gpkg"
each "/home/jcz/Github/niva/data/collected.gpkg" | clip "/home/jcz/Github/niva/data/study_area_bbox.gpkg" | save "/home/jcz/Github/niva/data/collected_clip.gpkg"

# Clip the reprojected DEM (raster) to the bbox:
load "/home/jcz/Github/niva/data/dem.tif" | clipraster "/home/jcz/Github/niva/data/study_area_bbox.gpkg" | save "/home/jcz/Github/niva/data/dem_clip.tif"


# --- Task 5: copy QGIS project files and repoint layers ----------------------
# !! ALERT — NOT AVAILABLE in niva yet (PLANNED — see docs/planning/04-roadmap.md
# "project & layer file manipulation"). Copying QGIS project files (.qgs/.qgz) and
# repointing their layer datasources to the clipped data is project-file editing,
# not geoprocessing. Until the planned `project` verb lands, do it in QGIS or a
# small PyQGIS script: QgsProject.read(), layer.setDataSource(<clipped uri>, name,
# "ogr"/"gdal"), then write into /data.
#     /home/jcz/Downloads/NiagaraOverture/  (data.qgs)
#     /home/jcz/Downloads/NiagaraBasemap/   (data.qgs, data_redesign.qgs)
#     /home/jcz/Github/marimo_qgis/example/ (project, if any)
# =============================================================================
