# Pure runnable niva — generated from validation_suite.niva by
#   python examples/run_validation_suite.py --emit
# Run it and watch every pipeline:  niva run <this file>
# Fully self-cleaning: file outputs are deleted with `remove` and DB tables with
# inline `sql … DROP`. Outputs land in /tmp/niva_validation/out during the run.

# ── PREAMBLE | environment & data | validate the environment before testing
info to=/tmp/niva_validation/out/00_info.md
show "@localpg" to=/tmp/niva_validation/out/00_localpg.md
show "@actual_spatialite.sqlite" to=/tmp/niva_validation/out/00_spatialite.md
catalog "{data}" to=/tmp/niva_validation/out/00_catalog.md
remove /tmp/niva_validation/out/00_info.md force    # cleanup
remove /tmp/niva_validation/out/00_localpg.md force    # cleanup
remove /tmp/niva_validation/out/00_spatialite.md force    # cleanup
remove /tmp/niva_validation/out/00_catalog.md force    # cleanup

# ── TEST 01 | gpkg→gpkg | GeoPackage polygon, passthrough save
load "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/out/t01.gpkg
remove /tmp/niva_validation/out/t01.gpkg    # cleanup

# ── TEST 02 | shp→gpkg | shapefile (MultiPolygon) to GeoPackage
load "{data}/aoism.shp" | save /tmp/niva_validation/out/t02.gpkg
remove /tmp/niva_validation/out/t02.gpkg    # cleanup

# ── TEST 03 | geojson→gpkg | GeoJSON (EPSG:4326) to GeoPackage
load "{data}/order_boundary.geojson" | save /tmp/niva_validation/out/t03.gpkg
remove /tmp/niva_validation/out/t03.gpkg    # cleanup

# ── TEST 04 | gpkg→shp | GeoPackage to shapefile
load "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/out/t04.shp
remove /tmp/niva_validation/out/t04.shp    # cleanup

# ── TEST 05 | gpkg→spatialite | GeoPackage to a SpatiaLite database
load "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/out/t05.sqlite as area
remove /tmp/niva_validation/out/t05.sqlite    # cleanup

# ── TEST 06 | gpkg→gpkg layer | multi-layer write (save as <layer>)
load "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/out/t06.gpkg as bbox
load "{data}/aoism.shp" | save /tmp/niva_validation/out/t06.gpkg as aoism
remove /tmp/niva_validation/out/t06.gpkg    # cleanup

# ── TEST 07 | tif→tif | GeoTIFF raster, passthrough save
load "{data}/dem_clip.tif" | save /tmp/niva_validation/out/t07.tif
remove /tmp/niva_validation/out/t07.tif    # cleanup

# ── TEST 08 | tif→tif | raster passthrough (original jp2 source not on this host)
load "{data}/dem_clip.tif" | save /tmp/niva_validation/out/t08.tif
remove /tmp/niva_validation/out/t08.tif    # cleanup

# ── TEST 09 | csv→gpkg | CSV (aspatial table) to GeoPackage
load "{data}/performance.csv" | save /tmp/niva_validation/out/t09.gpkg
remove /tmp/niva_validation/out/t09.gpkg    # cleanup

# ── TEST 10 | spatialite@conn→gpkg | load a SpatiaLite table by @conn
load "@actual_spatialite.sqlite.park_polygons" | save /tmp/niva_validation/out/t10.gpkg
remove /tmp/niva_validation/out/t10.gpkg    # cleanup

# ── TEST 11 | postgis@conn→gpkg | load a PostGIS table (the load_table fix)
load "@localpg.public.My Roads" | save /tmp/niva_validation/out/t11.gpkg
remove /tmp/niva_validation/out/t11.gpkg    # cleanup

# ── TEST 12 | postgis 2-geom→gpkg | table with two geometry columns (drop fix)
load "@localpg.public.two_geoms" | save /tmp/niva_validation/out/t12.gpkg
remove /tmp/niva_validation/out/t12.gpkg    # cleanup

# ── TEST 13 | reproject | EPSG:6346 → EPSG:4326
load "{data}/study_area_bbox.gpkg" | reproject EPSG:4326 | save /tmp/niva_validation/out/t13.gpkg
remove /tmp/niva_validation/out/t13.gpkg    # cleanup

# ── TEST 14 | buffer | 100 m buffer (source already in metres, EPSG:6346)
load "{data}/study_area_bbox.gpkg" | buffer 100m | save /tmp/niva_validation/out/t14.gpkg
remove /tmp/niva_validation/out/t14.gpkg    # cleanup

# ── TEST 15 | buffer options | dissolve + flat cap + segments
load "{data}/basemap.gpkg|layername=boundary-polygon-lvl2" | buffer 50m dissolve cap=flat segments=8 | save /tmp/niva_validation/out/t15.gpkg
remove /tmp/niva_validation/out/t15.gpkg    # cleanup

# ── TEST 16 | centroid | polygon → centroid point
load "{data}/basemap.gpkg|layername=boundary-polygon-lvl2" | centroid | save /tmp/niva_validation/out/t16.gpkg
remove /tmp/niva_validation/out/t16.gpkg    # cleanup

# ── TEST 17 | pointonsurface | guaranteed on-surface point
load "{data}/basemap.gpkg|layername=boundary-polygon-lvl2" | pointonsurface | save /tmp/niva_validation/out/t17.gpkg
remove /tmp/niva_validation/out/t17.gpkg    # cleanup

# ── TEST 18 | fixgeom | repair geometry
load "{data}/basemap.gpkg|layername=water-polygon" | fixgeom | save /tmp/niva_validation/out/t18.gpkg
remove /tmp/niva_validation/out/t18.gpkg    # cleanup

# ── TEST 19 | simplify | Douglas-Peucker 25 m
load "{data}/basemap.gpkg|layername=water-polygon" | fixgeom | simplify 25m | save /tmp/niva_validation/out/t19.gpkg
remove /tmp/niva_validation/out/t19.gpkg    # cleanup

# ── TEST 20 | convexhull | per-feature convex hull
load "{data}/basemap.gpkg|layername=boundary-polygon-lvl2" | convexhull | save /tmp/niva_validation/out/t20.gpkg
remove /tmp/niva_validation/out/t20.gpkg    # cleanup

# ── TEST 21 | boundingbox | axis-aligned bounding boxes
load "{data}/basemap.gpkg|layername=boundary-polygon-lvl2" | boundingbox | save /tmp/niva_validation/out/t21.gpkg
remove /tmp/niva_validation/out/t21.gpkg    # cleanup

# ── TEST 22 | explode | multipart → singlepart
load "{data}/basemap.gpkg|layername=water-polygon" | fixgeom | explode | save /tmp/niva_validation/out/t22.gpkg
remove /tmp/niva_validation/out/t22.gpkg    # cleanup

# ── TEST 23 | clip | clip water polygons to the study-area bbox
load "{data}/basemap.gpkg|layername=water-polygon" | clip "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/out/t23.gpkg
remove /tmp/niva_validation/out/t23.gpkg    # cleanup

# ── TEST 24 | dissolve | dissolve all water polygons into one
load "{data}/basemap.gpkg|layername=water-polygon" | fixgeom | dissolve | save /tmp/niva_validation/out/t24.gpkg
remove /tmp/niva_validation/out/t24.gpkg    # cleanup

# ── TEST 25 | difference | water polygons minus the bbox
load "{data}/basemap.gpkg|layername=water-polygon" | difference "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/out/t25.gpkg
remove /tmp/niva_validation/out/t25.gpkg    # cleanup

# ── TEST 26 | spatialjoin | join park polygons onto park points (SpatiaLite)
load "@actual_spatialite.sqlite.park_points" | spatialjoin with="@actual_spatialite.sqlite.park_polygons" predicate=within | save /tmp/niva_validation/out/t26.gpkg
remove /tmp/niva_validation/out/t26.gpkg    # cleanup

# ── TEST 27 | warp | reproject a raster to EPSG:4326
load "{data}/dem_clip.tif" | warp EPSG:4326 | save /tmp/niva_validation/out/t27.tif
remove /tmp/niva_validation/out/t27.tif    # cleanup

# ── TEST 28 | hillshade | shaded relief from the DEM
load "{data}/dem_clip.tif" | hillshade | save /tmp/niva_validation/out/t28.tif
remove /tmp/niva_validation/out/t28.tif    # cleanup

# ── TEST 29 | slope | slope (degrees) from the DEM
load "{data}/dem_clip.tif" | slope | save /tmp/niva_validation/out/t29.tif
remove /tmp/niva_validation/out/t29.tif    # cleanup

# ── TEST 30 | clipraster | clip the DEM to the study-area bbox
load "{data}/dem.tif" | clipraster "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/out/t30.tif
remove /tmp/niva_validation/out/t30.tif    # cleanup

# ── TEST 31 | zonalstats | summarise DEM values within the bbox polygon
load "{data}/study_area_bbox.gpkg" | zonalstats raster="{data}/dem.tif" stats=mean,min,max | save /tmp/niva_validation/out/t31.gpkg
remove /tmp/niva_validation/out/t31.gpkg    # cleanup

# ── TEST 32 | →postgis create | write a vector into PostGIS (mode=create)
load "{data}/study_area_bbox.gpkg" | save @localpg.public.nv_t32 mode=create
sql @localpg "DROP TABLE IF EXISTS public.nv_t32"    # cleanup

# ── TEST 33 | →postgis append | create then append (rows double)
load "@localpg.public.My Roads" | save @localpg.public.nv_t33 mode=create
load "@localpg.public.My Roads" | save @localpg.public.nv_t33 mode=append
sql @localpg "DROP TABLE IF EXISTS public.nv_t33"    # cleanup

# ── TEST 34 | →postgis replace | create then replace (rows stay = source)
load "@localpg.public.My Roads" | save @localpg.public.nv_t34 mode=create
load "@localpg.public.My Roads" | save @localpg.public.nv_t34 mode=replace
sql @localpg "DROP TABLE IF EXISTS public.nv_t34"    # cleanup

# ── TEST 35 | sql select | SELECT a subset from PostGIS into a layer
sql @localpg "SELECT * FROM public.\"My Roads\" WHERE id = 1" | save /tmp/niva_validation/out/t35.gpkg
remove /tmp/niva_validation/out/t35.gpkg    # cleanup

# ── TEST 36 | sql ddl | server-side CREATE TABLE AS, then load it back
sql @localpg "CREATE TABLE public.nv_t36 AS SELECT * FROM public.\"My Roads\""
load @localpg.public.nv_t36 | save /tmp/niva_validation/out/t36.gpkg
remove /tmp/niva_validation/out/t36.gpkg    # cleanup
sql @localpg "DROP TABLE IF EXISTS public.nv_t36"    # cleanup

# ── TEST 37 | remote wfs | list a WFS endpoint's feature types
show "https://demo.mapserver.org/cgi-bin/wfs?service=WFS" to=/tmp/niva_validation/out/t37.md
remove /tmp/niva_validation/out/t37.md force    # cleanup

# ── TEST 38 | multi-op chain | load PostGIS → reproject → fixgeom → buffer → centroid
load "@localpg.public.My Roads" | reproject EPSG:6346 | fixgeom | buffer 25m dissolve | centroid | save /tmp/niva_validation/out/t38.gpkg
remove /tmp/niva_validation/out/t38.gpkg    # cleanup

# ── TEST 39 | metadata + assess | stamp metadata, save, profile data quality
load "{data}/basemap.gpkg|layername=boundary-polygon-lvl2" | metadata set title="Validation lvl2" keywords=niva,test | save /tmp/niva_validation/out/t39.gpkg
load "/tmp/niva_validation/out/t39.gpkg" | assess deep to /tmp/niva_validation/out/t39_quality.md
remove /tmp/niva_validation/out/t39.gpkg    # cleanup
remove /tmp/niva_validation/out/t39_quality.md force    # cleanup

# ── TEST 40 | run + each + project | escape hatch, batch over a glob, build a project
load "{data}/study_area_bbox.gpkg" | save /tmp/niva_validation/batch/b1.gpkg
load "{data}/aoism.shp" | save /tmp/niva_validation/batch/b2.gpkg
each "/tmp/niva_validation/batch/*.gpkg" | run native:centroids | save /tmp/niva_validation/out/t40_batch.gpkg
project new from="/tmp/niva_validation/batch" to="/tmp/niva_validation/out/t40.qgs"
remove /tmp/niva_validation/out/t40_batch.gpkg    # cleanup
remove /tmp/niva_validation/out/t40.qgs    # cleanup
remove /tmp/niva_validation/batch/b1.gpkg    # cleanup
remove /tmp/niva_validation/batch/b2.gpkg    # cleanup
