# Pure runnable niva — generated from validation_suite.niva by
#   python examples/run_validation_suite.py --emit
# Run it and watch every pipeline:  niva run <this file>
# Fully self-cleaning: file outputs are deleted with `remove` and DB tables with
# inline `sql … DROP`. Outputs land in /tmp/niva_validation/out during the run.

# ── PREAMBLE | environment & new-feature surfaces | validate before testing
show "@actual_spatialite.sqlite" to=/tmp/niva_validation/out/b2_00_spatialite.md
load "@actual_spatialite.sqlite.park_polygons" | assess deep to /tmp/niva_validation/out/b2_00_parks.md
catalog "{data}" to=/tmp/niva_validation/out/b2_00_catalog.md
remove /tmp/niva_validation/out/b2_00_spatialite.md force    # cleanup
remove /tmp/niva_validation/out/b2_00_parks.md force    # cleanup
remove /tmp/niva_validation/out/b2_00_catalog.md force    # cleanup

# ── TEST 01 | filter | extract by expression ($area)
load "{data}/basemap.gpkg|layername=landuse-polygon" | filter "$area > 1000" | save /tmp/niva_validation/out/b2_01.gpkg
remove /tmp/niva_validation/out/b2_01.gpkg    # cleanup

# ── TEST 02 | keepfields | retain only two attributes
load "{data}/basemap.gpkg|layername=boundary-polygon" | keepfields "NAME,ADMIN_LVL" | save /tmp/niva_validation/out/b2_02.gpkg
remove /tmp/niva_validation/out/b2_02.gpkg    # cleanup

# ── TEST 03 | dropfields | delete two attributes
load "{data}/basemap.gpkg|layername=boundary-polygon" | dropfields "OSM_TYPE,NAME_EN" | save /tmp/niva_validation/out/b2_03.gpkg
remove /tmp/niva_validation/out/b2_03.gpkg    # cleanup

# ── TEST 04 | renamefield | rename an attribute
load "{data}/basemap.gpkg|layername=settlement-point" | renamefield NAME label | save /tmp/niva_validation/out/b2_04.gpkg
remove /tmp/niva_validation/out/b2_04.gpkg    # cleanup

# ── TEST 05 | join | attribute join on a field
load "{data}/collected.gpkg|layername=park_polygons" | join with="{data}/collected.gpkg|layername=park_points" field=id field2=id | save /tmp/niva_validation/out/b2_05.gpkg
remove /tmp/niva_validation/out/b2_05.gpkg    # cleanup

# ── TEST 06 | voronoi | Thiessen polygons from points
load "{data}/basemap.gpkg|layername=settlement-point" | voronoi | save /tmp/niva_validation/out/b2_06.gpkg
remove /tmp/niva_validation/out/b2_06.gpkg    # cleanup

# ── TEST 07 | delaunay | triangulation from points
load "{data}/basemap.gpkg|layername=settlement-point" | delaunay | save /tmp/niva_validation/out/b2_07.gpkg
remove /tmp/niva_validation/out/b2_07.gpkg    # cleanup

# ── TEST 08 | collect | aggregate points to one multipoint
load "{data}/basemap.gpkg|layername=settlement-point" | collect | save /tmp/niva_validation/out/b2_08.gpkg
remove /tmp/niva_validation/out/b2_08.gpkg    # cleanup

# ── TEST 09 | pointsalong | points spaced along lines
load "{data}/basemap.gpkg|layername=railway-line" | pointsalong 500m | save /tmp/niva_validation/out/b2_09.gpkg
remove /tmp/niva_validation/out/b2_09.gpkg    # cleanup

# ── TEST 10 | vertices | explode geometries to their vertices
load "{data}/basemap.gpkg|layername=nature_reserve-polygon" | vertices | save /tmp/niva_validation/out/b2_10.gpkg
remove /tmp/niva_validation/out/b2_10.gpkg    # cleanup

# ── TEST 11 | offset | parallel line at a distance
load "{data}/collected.gpkg|layername=park_lines" | offset 25m | save /tmp/niva_validation/out/b2_11.gpkg
remove /tmp/niva_validation/out/b2_11.gpkg    # cleanup

# ── TEST 12 | densify | add vertices at fixed spacing
load "{data}/collected.gpkg|layername=park_lines" | densify 10m | save /tmp/niva_validation/out/b2_12.gpkg
remove /tmp/niva_validation/out/b2_12.gpkg    # cleanup

# ── TEST 13 | smooth | round off sharp corners
load "{data}/collected.gpkg|layername=park_lines" | smooth iterations=2 | save /tmp/niva_validation/out/b2_13.gpkg
remove /tmp/niva_validation/out/b2_13.gpkg    # cleanup

# ── TEST 14 | subdivide | cap vertices per part
load "{data}/basemap.gpkg|layername=nature_reserve-polygon" | subdivide max_nodes=64 | save /tmp/niva_validation/out/b2_14.gpkg
remove /tmp/niva_validation/out/b2_14.gpkg    # cleanup

# ── TEST 15 | minrect | oriented minimum bounding rectangle
load "{data}/collected.gpkg|layername=park_polygons" | minrect | save /tmp/niva_validation/out/b2_15.gpkg
remove /tmp/niva_validation/out/b2_15.gpkg    # cleanup

# ── TEST 16 | swapxy | swap X/Y coordinates
load "{data}/study_area_bbox.gpkg" | swapxy | save /tmp/niva_validation/out/b2_16.gpkg
remove /tmp/niva_validation/out/b2_16.gpkg    # cleanup

# ── TEST 17 | forcerhr | enforce right-hand-rule ring order
load "{data}/basemap.gpkg|layername=nature_reserve-polygon" | forcerhr | save /tmp/niva_validation/out/b2_17.gpkg
remove /tmp/niva_validation/out/b2_17.gpkg    # cleanup

# ── TEST 18 | promote | singlepart → multipart
load "{data}/collected.gpkg|layername=park_lines" | promote | save /tmp/niva_validation/out/b2_18.gpkg
remove /tmp/niva_validation/out/b2_18.gpkg    # cleanup

# ── TEST 19 | sample | random subset of N features
load "{data}/basemap.gpkg|layername=poi-point" | sample 10 | save /tmp/niva_validation/out/b2_19.gpkg
remove /tmp/niva_validation/out/b2_19.gpkg    # cleanup

# ── TEST 20 | clip @conn | clip the study-area bbox down to a SpatiaLite layer
load "{data}/study_area_bbox.gpkg" | clip "@actual_spatialite.sqlite.park_polygons" | save /tmp/niva_validation/out/b2_20.gpkg
remove /tmp/niva_validation/out/b2_20.gpkg    # cleanup

# ── TEST 21 | intersect @conn | intersect the study-area bbox with a SpatiaLite layer
load "{data}/study_area_bbox.gpkg" | intersect "@actual_spatialite.sqlite.park_polygons" | save /tmp/niva_validation/out/b2_21.gpkg
remove /tmp/niva_validation/out/b2_21.gpkg    # cleanup

# ── TEST 22 | difference @conn | erase SpatiaLite parks from basemap water
load "{data}/basemap.gpkg|layername=water-polygon" | difference "@actual_spatialite.sqlite.park_polygons" | save /tmp/niva_validation/out/b2_22.gpkg
remove /tmp/niva_validation/out/b2_22.gpkg    # cleanup

# ── TEST 23 | union @conn | union with a SpatiaLite layer
load "{data}/collected.gpkg|layername=park_polygons" | union "@actual_spatialite.sqlite.park_polygons" | save /tmp/niva_validation/out/b2_23.gpkg
remove /tmp/niva_validation/out/b2_23.gpkg    # cleanup

# ── TEST 24 | symdifference @conn | symmetric difference with SpatiaLite
load "{data}/basemap.gpkg|layername=nature_reserve-polygon" | symdifference "@actual_spatialite.sqlite.park_polygons" | save /tmp/niva_validation/out/b2_24.gpkg
remove /tmp/niva_validation/out/b2_24.gpkg    # cleanup

# ── TEST 25 | spatialjoin with=@conn | join SpatiaLite attrs onto basemap points
load "{data}/basemap.gpkg|layername=poi-point" | spatialjoin with="@actual_spatialite.sqlite.park_polygons" predicate=within | save /tmp/niva_validation/out/b2_25.gpkg
remove /tmp/niva_validation/out/b2_25.gpkg    # cleanup

# ── TEST 26 | selectloc against=@conn | keep features intersecting a SpatiaLite layer
load "{data}/study_area_bbox.gpkg" | selectloc "@actual_spatialite.sqlite.park_polygons" predicate=intersect | save /tmp/niva_validation/out/b2_26.gpkg
remove /tmp/niva_validation/out/b2_26.gpkg    # cleanup

# ── TEST 27 | snap reference=@conn | snap park lines to SpatiaLite park lines
load "{data}/collected.gpkg|layername=park_lines" | snap "@actual_spatialite.sqlite.park_lines" 5m | save /tmp/niva_validation/out/b2_27.gpkg
remove /tmp/niva_validation/out/b2_27.gpkg    # cleanup

# ── TEST 28 | countpoints points=@conn | count SpatiaLite points per polygon
load "{data}/collected.gpkg|layername=park_polygons" | countpoints points="@actual_spatialite.sqlite.park_points" | save /tmp/niva_validation/out/b2_28.gpkg
remove /tmp/niva_validation/out/b2_28.gpkg    # cleanup

# ── TEST 29 | sql ST_Centroid (PostGIS) | computed geometry must survive
sql @localpg "SELECT row_number() OVER () AS id, ST_Centroid(geom) AS geom FROM public.\"My Roads\"" | save /tmp/niva_validation/out/b2_29.gpkg
remove /tmp/niva_validation/out/b2_29.gpkg    # cleanup

# ── TEST 30 | sql ST_Buffer (PostGIS) | computed polygon geometry must survive
sql @localpg "SELECT row_number() OVER () AS id, ST_Buffer(geom, 0.001) AS geom FROM public.\"My Roads\"" | save /tmp/niva_validation/out/b2_30.gpkg
remove /tmp/niva_validation/out/b2_30.gpkg    # cleanup

# ── TEST 31 | sql ST_Centroid (SpatiaLite) | computed geometry, other backend
sql "@actual_spatialite.sqlite" "SELECT ST_Centroid(GEOMETRY) AS geom FROM park_polygons" | save /tmp/niva_validation/out/b2_31.gpkg
remove /tmp/niva_validation/out/b2_31.gpkg    # cleanup

# ── TEST 32 | aspect | DEM → aspect raster
load "{data}/dem_clip.tif" | aspect | save /tmp/niva_validation/out/b2_32.tif
remove /tmp/niva_validation/out/b2_32.tif    # cleanup

# ── TEST 33 | slope percent | DEM → slope raster (as percent)
load "{data}/dem_clip.tif" | slope percent | save /tmp/niva_validation/out/b2_33.tif
remove /tmp/niva_validation/out/b2_33.tif    # cleanup

# ── TEST 34 | warp→polygonize | coarsen a DEM then vectorize it (raster→vector)
load "{data}/dem_clip.tif" | warp EPSG:6346 resolution=300 | polygonize | save /tmp/niva_validation/out/b2_34.gpkg
remove /tmp/niva_validation/out/b2_34.gpkg    # cleanup

# ── TEST 35 | corridor | lines → buffer+dissolve → fixgeom (3 ops)
load "{data}/basemap.gpkg|layername=railway-line" | buffer 50m dissolve | fixgeom | save /tmp/niva_validation/out/b2_35.gpkg
remove /tmp/niva_validation/out/b2_35.gpkg    # cleanup

# ── TEST 36 | point footprint | points → buffer → dissolve → convexhull (4 ops)
load "{data}/basemap.gpkg|layername=settlement-point" | buffer 1000m | dissolve | convexhull | save /tmp/niva_validation/out/b2_36.gpkg
remove /tmp/niva_validation/out/b2_36.gpkg    # cleanup

# ── TEST 37 | clean+overlay chain | fixgeom → simplify → difference @conn (3 ops, @conn)
load "{data}/basemap.gpkg|layername=water-polygon" | fixgeom | simplify 5 | difference "@actual_spatialite.sqlite.park_polygons" | save /tmp/niva_validation/out/b2_37.gpkg
remove /tmp/niva_validation/out/b2_37.gpkg    # cleanup

# ── TEST 38 | split | extract one geometry type
load "{data}/basemap.gpkg|layername=poi-point" | split point | save /tmp/niva_validation/out/b2_38.gpkg
remove /tmp/niva_validation/out/b2_38.gpkg    # cleanup

# ── TEST 39 | each {name} templating | batch over a folder, templated outputs
load "{data}/basemap.gpkg|layername=settlement-point" | save /tmp/niva_validation/b2batch/towns.gpkg
load "{data}/basemap.gpkg|layername=poi-point" | sample 20 | save /tmp/niva_validation/b2batch/poi.gpkg
each "/tmp/niva_validation/b2batch/*.gpkg" | voronoi | save "/tmp/niva_validation/out/b2_39_{name}.gpkg"
remove /tmp/niva_validation/out/b2_39_towns.gpkg    # cleanup
remove /tmp/niva_validation/out/b2_39_poi.gpkg    # cleanup
remove /tmp/niva_validation/b2batch/towns.gpkg    # cleanup
remove /tmp/niva_validation/b2batch/poi.gpkg    # cleanup

# ── TEST 40 | style + project | export a style, then build a project from outputs
load "{data}/study_area_bbox.gpkg" | metadata set title="Suite2 study area" keywords="niva,qa" | save /tmp/niva_validation/b2proj/study.gpkg | style save /tmp/niva_validation/out/b2_40.qml
project new from="/tmp/niva_validation/b2proj" to="/tmp/niva_validation/out/b2_40.qgs" crs=EPSG:6346 title="Suite 2"
remove /tmp/niva_validation/out/b2_40.qml    # cleanup
remove /tmp/niva_validation/out/b2_40.qgs    # cleanup
remove /tmp/niva_validation/b2proj/study.gpkg    # cleanup
