# ------------------------------------------------- COMPLEX & UTILITY

# ===== TEST 38 | multi-op chain | load PostGIS → reproject → fixgeom → buffer → centroid =====
load "@localpg.public.My Roads" | reproject EPSG:6346 | fixgeom | buffer 25m dissolve | centroid | save /tmp/niva_validation/out/t38.gpkg
#@out /tmp/niva_validation/out/t38.gpkg :: vector >=1
#@cleanup rm /tmp/niva_validation/out/t38.gpkg

# ===== TEST 39 | metadata + assess | stamp metadata, save, profile data quality =====
load "/home/jcz/Github/niva/data/basemap.gpkg|layername=boundary-polygon-lvl2" | metadata set title="Validation lvl2" keywords=niva,test | save /tmp/niva_validation/out/t39.gpkg
load "/tmp/niva_validation/out/t39.gpkg" | assess deep to /tmp/niva_validation/out/t39_quality.md
#@out /tmp/niva_validation/out/t39.gpkg :: vector >=1
#@out /tmp/niva_validation/out/t39_quality.md :: file
#@cleanup rm /tmp/niva_validation/out/t39.gpkg
#@cleanup rm /tmp/niva_validation/out/t39_quality.md

# ===== TEST 40 | run + each + project | escape hatch, batch over a glob, build a project =====
load "/home/jcz/Github/niva/data/study_area_bbox.gpkg" | save /tmp/niva_validation/batch/b1.gpkg
load "/home/jcz/Downloads/NiagaraBasemap/aoism.shp" | save /tmp/niva_validation/batch/b2.gpkg
each "/tmp/niva_validation/batch/*.gpkg" | run native:centroids | save /tmp/niva_validation/out/t40_batch.gpkg
project new from="/tmp/niva_validation/batch" to="/tmp/niva_validation/out/t40.qgs"
#@out /tmp/niva_validation/out/t40_batch.gpkg :: vector >=1
#@out /tmp/niva_validation/out/t40.qgs :: file
#@cleanup rm /tmp/niva_validation/out/t40_batch.gpkg
#@cleanup rm /tmp/niva_validation/out/t40.qgs
#@cleanup rm /tmp/niva_validation/batch/b1.gpkg
#@cleanup rm /tmp/niva_validation/batch/b2.gpkg
