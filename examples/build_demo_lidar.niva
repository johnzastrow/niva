# =============================================================================
# build_demo_lidar.niva — clip the Youngstown LiDAR to AOISM and export a DEM
# =============================================================================
# NOTE: this uses the QGIS `pdal:` provider (`run pdal:*`), which needs QGIS built
# with the PDAL data provider (raw LAS must be COPC-indexed to load). On a build
# without it (e.g. Ubuntu 26.04 QGIS 4.0.3), use the native-CLI harness instead —
# `run pdalcli:*` reads raw LAS/LAZ/COPC directly, no COPC step. A verified,
# equivalent workflow set lives in examples/lidar_pdal_grass.niva. See
# docs/guide/pdal-lastools-qgis4.md for both paths.
#
# Builds examples/demo/lidar.laz (+ lidar_dem.tif) from the seven ~/Downloads
# 17TPH*.las tiles that overlap AOISM, for the cookbook's PDAL recipes (§K 63-66).
#
# RUN THIS WHERE QGIS HAS WORKING PDAL POINT-CLOUD SUPPORT. niva reaches PDAL via
# `run pdal:*`; point clouds are not niva `load`/`save` layers, so each step gives
# the OUTPUT path explicitly. FIRST confirm the tiles' CRS matches AOISM
# (EPSG:6346) — if it differs, reproject AOISM (or the cloud) so the clip overlay
# lines up. The raw tiles total ~3.4 GB; set NIVA_TMPDIR to a roomy disk.
# =============================================================================

# 1. Merge the AOISM-overlapping tiles into one cloud.
run pdal:merge LAYERS="~/Downloads/17TPH570895.las;~/Downloads/17TPH570910.las;~/Downloads/17TPH585895.las;~/Downloads/17TPH585910.las;~/Downloads/17TPH585925.las;~/Downloads/17TPH600895.las;~/Downloads/17TPH600910.las" OUTPUT="~/niva_scratch/ytown_merged.laz"

# 2. Clip the merged cloud to the AOISM polygon (built by build_demo_data.niva).
run pdal:clip INPUT="~/niva_scratch/ytown_merged.laz" OVERLAY="~/Github/niva/examples/demo/demo.gpkg|layername=aoi" OUTPUT="~/Github/niva/examples/demo/lidar.laz"

# 3. Export a 1 m DEM from the clipped cloud (then niva can hillshade/slope it).
run pdal:exportraster INPUT="~/Github/niva/examples/demo/lidar.laz" ATTRIBUTE=Z RESOLUTION=1 OUTPUT="~/Github/niva/examples/demo/lidar_dem.tif"
