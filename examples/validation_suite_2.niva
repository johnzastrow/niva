# ===== TEST 19 | sample | random subset of N features =====
load "/home/jcz/Github/niva/data/basemap.gpkg|layername=poi-point" | sample 10 | save /tmp/niva_validation/out/b2_19.gpkg
#@out /tmp/niva_validation/out/b2_19.gpkg :: vector >=10
