# =============================================================================
# niva VALIDATION SUITE 2 — "different & more complex"  (companion to validation_suite.niva)
# =============================================================================
# Suite 1 covered the bread-and-butter: every format in/out, the common processing
# verbs, basic DB CRUD. Suite 2 deliberately exercises the parts suite 1 left alone
# and pushes harder:
#
#   • attribute / field surgery        filter keepfields dropfields renamefield join
#   • point/line *creation* geometry   voronoi delaunay collect pointsalong vertices
#                                       offset densify smooth subdivide minrect sample
#                                       swapxy forcerhr promote
#   • @conn as a SECONDARY layer       clip/intersect/difference/union/symdifference,
#     (the v0.33.0 feature)            spatialjoin with=, selectloc against,
#                                       snap reference=, countpoints points=  — all
#                                       pointing at @actual_spatialite.sqlite tables
#   • SQL that COMPUTES geometry       ST_Centroid / ST_Buffer in PostGIS & SpatiaLite
#                                       (proves the "sql keeps geometry" fix end to end)
#   • raster → vector + raster combos  aspect, slope %, warp→polygonize
#   • deep multi-op chains             5+ stages, mixing reproject/buffer/dissolve/@conn
#   • orchestration                    split, each with {name} templating, style, project
#
# Same harness, same per-test rhythm:  ASSESS the output  →  the op already ran  →  CLEAN UP.
# Run with:
#   PYTHONPATH=<repo>:/usr/share/qgis/python:/usr/lib/python3/dist-packages \
#     QT_QPA_PLATFORM=offscreen python3 examples/run_validation_suite.py examples/validation_suite_2.niva
#
# Directive syntax (parsed by run_validation_suite.py — they are ordinary niva comments,
# so this file is ALSO directly runnable with `niva run`):
#   # ===== TEST NN | category | description =====   block header
#   <flow line(s)>                                    executed in order
#   #@out <path|@conn.table> :: <vector|raster|table|file> [>=N]   output assertion(s)
#   #@cleanup remove <path> [force]                   delete a file output via niva's `remove`
#                                                     (handles sidecars; `force` for non-geodata)
#   #@cleanup flow <niva flow>                        run a cleanup flow (e.g. sql DROP)
#
# All spatialite park_* tables and the basemap layers are EPSG:6346, so @conn overlays
# are same-CRS. @localpg "My Roads"/two_geoms are EPSG:4326 (geometry column `geom`).
# =============================================================================


# ===== PREAMBLE | environment & new-feature surfaces | validate before testing =====
# Confirm the @conn the secondary-layer tests depend on is reachable and its parks have geometry.
show "@actual_spatialite.sqlite" to=/tmp/niva_validation/out/b2_00_spatialite.md
load "@actual_spatialite.sqlite.park_polygons" | assess deep to /tmp/niva_validation/out/b2_00_parks.md
catalog "/home/jcz/Github/niva/data" to=/tmp/niva_validation/out/b2_00_catalog.md
#@out /tmp/niva_validation/out/b2_00_spatialite.md :: file
#@out /tmp/niva_validation/out/b2_00_parks.md :: file
#@out /tmp/niva_validation/out/b2_00_catalog.md :: file
#@cleanup remove /tmp/niva_validation/out/b2_00_spatialite.md force
#@cleanup remove /tmp/niva_validation/out/b2_00_parks.md force
#@cleanup remove /tmp/niva_validation/out/b2_00_catalog.md force


# ----------------------------------------------------------------- attribute / field ops
# ===== TEST 01 | filter | extract by expression ($area) =====
load "/home/jcz/Github/niva/data/basemap.gpkg|layername=landuse-polygon" | filter "$area > 1000" | save /tmp/niva_validation/out/b2_01.gpkg
#@out /tmp/niva_validation/out/b2_01.gpkg :: vector >=1
#@cleanup remove /tmp/niva_validation/out/b2_01.gpkg

# ===== TEST 02 | keepfields | retain only two attributes =====
load "/home/jcz/Github/niva/data/basemap.gpkg|layername=boundary-polygon" | keepfields "NAME,ADMIN_LVL" | save /tmp/niva_validation/out/b2_02.gpkg
#@out /tmp/niva_validation/out/b2_02.gpkg :: vector >=1
#@cleanup remove /tmp/niva_validation/out/b2_02.gpkg

# ===== TEST 03 | dropfields | delete two attributes =====
load "/home/jcz/Github/niva/data/basemap.gpkg|layername=boundary-polygon" | dropfields "OSM_TYPE,NAME_EN" | save /tmp/niva_validation/out/b2_03.gpkg
#@out /tmp/niva_validation/out/b2_03.gpkg :: vector >=1
#@cleanup remove /tmp/niva_validation/out/b2_03.gpkg

# ===== TEST 04 | renamefield | rename an attribute =====
load "/home/jcz/Github/niva/data/basemap.gpkg|layername=settlement-point" | renamefield NAME label | save /tmp/niva_validation/out/b2_04.gpkg
#@out /tmp/niva_validation/out/b2_04.gpkg :: vector >=1
#@cleanup remove /tmp/niva_validation/out/b2_04.gpkg

# ===== TEST 05 | join | attribute join on a field =====
load "/home/jcz/Github/niva/data/collected.gpkg|layername=park_polygons" | join with="/home/jcz/Github/niva/data/collected.gpkg|layername=park_points" field=id field2=id | save /tmp/niva_validation/out/b2_05.gpkg
#@out /tmp/niva_validation/out/b2_05.gpkg :: vector >=1
#@cleanup remove /tmp/niva_validation/out/b2_05.gpkg


# --------------------------------------------------------- point/line creation geometry
# ===== TEST 06 | voronoi | Thiessen polygons from points =====
load "/home/jcz/Github/niva/data/basemap.gpkg|layername=settlement-point" | voronoi | save /tmp/niva_validation/out/b2_06.gpkg
#@out /tmp/niva_validation/out/b2_06.gpkg :: vector >=1
#@cleanup remove /tmp/niva_validation/out/b2_06.gpkg

