# =============================================================================
# build_demo_data.niva — build niva's demonstration dataset, using niva
# =============================================================================
# Objective (see demo_data_usecase.md): turn the raw Youngstown sources into a
# tidy, self-contained body of demo data under examples/demo/ that exercises the
# cookbook. This script *is* a niva demo: niva building niva's own data.
#
# All demo VECTORS live in ONE GeoPackage — examples/demo/demo.gpkg — as named
# layers (every source layer, plus the enhanced `parcels`/`ny_ytown_streets` and a
# derived `floodzone`, plus friendly aliases roads/buildings/aoi/points/watersheds
# the cookbook reads). Rasters, CSVs, the SpatiaLite DB, the project and the style
# are separate files. So: a handful of files, not dozens.
#
# Sources (author-local): examples/data/example.gpkg (25-layer Youngstown GeoPackage)
# and ~/Downloads/ytown_dem.tif (a 1 m DEM). Study area: the AOISM polygon
# (EPSG:6346). LiDAR and PostGIS are built by build_demo_lidar.niva /
# build_demo_postgis.niva.
#
# Run headless (raster scratch on a real disk — see the User Guide):
#   NIVA_TMPDIR=$HOME/niva_scratch \
#   PYTHONPATH=$PWD:/usr/lib/python3/dist-packages:/usr/share/qgis/python \
#   QT_QPA_PLATFORM=offscreen python3.14 -c \
#     "import niva; niva.run_file('examples/build_demo_data.niva')"
# =============================================================================

# --- Task 1: every source layer into ONE GeoPackage (reprojected to EPSG:6346) -
# `each` over the source container writes one layer per source layer into demo.gpkg;
# a layer that can't be reprojected/written (no geometry, odd type) is skipped.
each "~/Github/niva/examples/data/example.gpkg" | reproject EPSG:6346 | save "~/Github/niva/examples/demo/demo.gpkg"

# --- Task 2: enhanced + friendly-named layers, into the SAME GeoPackage ---------
# Add synthetic columns and a couple of derived/aliased layers. `parcels` is
# overwritten in place to gain `zoning`; `ny_ytown_streets` gains `class`; the rest
# are added as new named layers (the cookbook reads roads/buildings/aoi/points/
# watersheds/floodzone). All read back from demo.gpkg (already in EPSG:6346).
load "~/Github/niva/examples/demo/demo.gpkg|layername=parcels" | run native:fieldcalculator FIELD_NAME=zoning FIELD_TYPE=2 FORMULA="CASE WHEN ACRES > 1 THEN 'R1' WHEN ACRES > 0.3 THEN 'R2' ELSE 'C' END" | save "~/Github/niva/examples/demo/demo.gpkg" as parcels
load "~/Github/niva/examples/demo/demo.gpkg|layername=ny_ytown_streets" | run native:fieldcalculator FIELD_NAME=class FIELD_TYPE=2 FORMULA="CASE WHEN $id % 5 = 0 THEN 'primary' WHEN $id % 2 = 0 THEN 'secondary' ELSE 'local' END" | save "~/Github/niva/examples/demo/demo.gpkg" as roads
load "~/Github/niva/examples/demo/demo.gpkg|layername=AOISM" | save "~/Github/niva/examples/demo/demo.gpkg" as aoi
load "~/Github/niva/examples/demo/demo.gpkg|layername=ny_ytown_buildings" | save "~/Github/niva/examples/demo/demo.gpkg" as buildings
load "~/Github/niva/examples/demo/demo.gpkg|layername=gnis" | save "~/Github/niva/examples/demo/demo.gpkg" as points
load "~/Github/niva/examples/demo/demo.gpkg|layername=nhdplus_catchment" | save "~/Github/niva/examples/demo/demo.gpkg" as watersheds
load "~/Github/niva/examples/demo/demo.gpkg|layername=nhd_flowlines" | buffer 60m dissolve | save "~/Github/niva/examples/demo/demo.gpkg" as floodzone

# --- Task 3: rasters (a 10 m DEM clipped to AOISM + the usual derivatives) -------
# Clip masks come from demo.gpkg|layername=aoi. Downsample to 10 m so the committed
# demo rasters stay small.
load "~/Downloads/ytown_dem.tif" | warp EPSG:6346 resolution=10 resampling=average | clipraster "~/Github/niva/examples/demo/demo.gpkg|layername=aoi" | save "~/Github/niva/examples/demo/dem.tif"
load "~/Github/niva/examples/demo/dem.tif" | hillshade | save "~/Github/niva/examples/demo/hillshade.tif"
load "~/Github/niva/examples/demo/dem.tif" | slope | save "~/Github/niva/examples/demo/slope.tif"
load "~/Github/niva/examples/demo/dem.tif" | aspect | save "~/Github/niva/examples/demo/aspect.tif"
# slope doubles as a movement-cost surface for grass:r.cost
load "~/Github/niva/examples/demo/dem.tif" | slope | save "~/Github/niva/examples/demo/cost_surface.tif"
# a categorical INTEGER raster (catchment GridCode at 20 m, Int32) so `polygonize` works
load "~/Github/niva/examples/demo/demo.gpkg|layername=nhdplus_catchment" | clip "~/Github/niva/examples/demo/demo.gpkg|layername=aoi" | run gdal:rasterize FIELD=GridCode UNITS=1 WIDTH=20 HEIGHT=20 DATA_TYPE=4 | save "~/Github/niva/examples/demo/landcover.tif"
# a DEM with a NoData hole (a donut clip) for gdal:fillnodata
load "~/Github/niva/examples/demo/demo.gpkg|layername=aoi" | centroid | buffer 700m | save "~/Github/niva/examples/demo/_hole.gpkg"
load "~/Github/niva/examples/demo/demo.gpkg|layername=aoi" | difference "~/Github/niva/examples/demo/_hole.gpkg" | save "~/Github/niva/examples/demo/_donut.gpkg"
load "~/Github/niva/examples/demo/dem.tif" | clipraster "~/Github/niva/examples/demo/_donut.gpkg" | save "~/Github/niva/examples/demo/gappy.tif"
# a target raster (streams burned to 1) for gdal:proximity
load "~/Github/niva/examples/demo/demo.gpkg|layername=nhd_flowlines" | clip "~/Github/niva/examples/demo/demo.gpkg|layername=aoi" | run gdal:rasterize BURN=1 UNITS=1 WIDTH=20 HEIGHT=20 | save "~/Github/niva/examples/demo/targets.tif"

# --- Task 4: tabular inputs for the join recipes ------------------------------
# census.csv: a tract key + synthetic pop/income. owners.csv: a parcel key + owner.
load "~/Github/niva/examples/demo/demo.gpkg|layername=nhdplus_catchment" | run native:fieldcalculator FIELD_NAME=pop FIELD_TYPE=1 FORMULA="round(rand(200, 8000))" | run native:fieldcalculator FIELD_NAME=income FIELD_TYPE=1 FORMULA="round(rand(25000, 140000))" | keepfields NHDPlusID,pop,income | save "~/Github/niva/examples/demo/census.csv"
load "~/Github/niva/examples/demo/demo.gpkg|layername=parcels" | keepfields PrintKey,OwnrName | save "~/Github/niva/examples/demo/owners.csv"

# --- Task 5: a SpatiaLite database for the `@sl` SQL recipes -------------------
# One .sqlite (a real SpatiaLite DB) holding parcels/roads/points/zones. Register it
# in QGIS as a SpatiaLite connection named `sl` to run the cookbook §G recipes.
load "~/Github/niva/examples/demo/demo.gpkg|layername=parcels" | save "~/Github/niva/examples/demo/youngstown.sqlite" as parcels
load "~/Github/niva/examples/demo/demo.gpkg|layername=roads" | save "~/Github/niva/examples/demo/youngstown.sqlite" as roads
load "~/Github/niva/examples/demo/demo.gpkg|layername=points" | save "~/Github/niva/examples/demo/youngstown.sqlite" as points
load "~/Github/niva/examples/demo/demo.gpkg|layername=ny_ytown_stateparks" | save "~/Github/niva/examples/demo/youngstown.sqlite" as zones

# --- Task 6: a QGIS project + a style sidecar ---------------------------------
project new from="~/Github/niva/examples/demo/demo.gpkg" to="~/Github/niva/examples/demo/youngstown.qgs" crs=EPSG:6346 title="Youngstown demo"
load "~/Github/niva/examples/demo/demo.gpkg|layername=roads" | style save "~/Github/niva/examples/demo/house.qml"

# --- Task 7: an inventory of everything we just built -------------------------
catalog "~/Github/niva/examples/demo" to="~/Github/niva/examples/demo/catalog.md"
